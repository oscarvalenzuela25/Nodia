{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nodia:ai:invoice-analysis:v1",
  "$defs": {
    "InvoiceAnalysisItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "packages": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "units_per_package": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_price_tax": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_price": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "name",
        "code",
        "quantity",
        "packages",
        "units_per_package",
        "cost_price",
        "cost_price_tax",
        "unit_price",
        "total_price"
      ]
    },
    "InvoiceAnalysisExtraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "total_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issue_date": {
              "anyOf": [
                {
                  "const": ""
                },
                {
                  "type": "string",
                  "format": "date",
                  "maxLength": 10
                }
              ]
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/InvoiceAnalysisItem"
              }
            }
          },
          "required": [
            "issue_date",
            "items"
          ]
        }
      },
      "required": [
        "code",
        "total_amount",
        "data"
      ]
    },
    "InvoiceAnalysisSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "kind": {
          "enum": [
            "pdf",
            "image"
          ]
        }
      },
      "required": [
        "attachment_id",
        "byte_count",
        "media_type",
        "kind"
      ]
    },
    "InvoiceAnalysisSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "maxLength": 19
        },
        "mode": {
          "enum": [
            "agentic",
            "api_key"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "effort_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "connection_id",
        "mode",
        "model_id",
        "effort_id"
      ]
    },
    "InvoiceAnalysisPrepareInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "prepare"
        },
        "business_id": {
          "type": "string",
          "format": "uuid"
        },
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "maxLength": 19
        }
      },
      "required": [
        "action",
        "business_id",
        "attachment_id"
      ]
    },
    "InvoiceAnalysisCompleteInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "complete"
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "extraction": {
          "$ref": "#/$defs/InvoiceAnalysisExtraction"
        }
      },
      "required": [
        "action",
        "analysis_id",
        "extraction"
      ]
    },
    "InvoiceAnalysisInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/InvoiceAnalysisPrepareInput"
        },
        {
          "$ref": "#/$defs/InvoiceAnalysisCompleteInput"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "prepare",
            "complete"
          ]
        },
        "business_id": {
          "type": "string",
          "format": "uuid"
        },
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "maxLength": 19
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "extraction": {
          "$ref": "#/$defs/InvoiceAnalysisExtraction"
        }
      },
      "required": [
        "action"
      ]
    },
    "InvoiceAnalysisPreparedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "prepared"
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_required": {
          "const": true
        },
        "extraction_source": {
          "enum": [
            "active_agentic_generation",
            "active_api_generation"
          ]
        },
        "business_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "$ref": "#/$defs/InvoiceAnalysisSource"
        },
        "selection": {
          "$ref": "#/$defs/InvoiceAnalysisSelection"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        }
      },
      "required": [
        "status",
        "analysis_id",
        "review_required",
        "extraction_source",
        "business_id",
        "provider_id",
        "attachment_id",
        "source",
        "selection",
        "instructions"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/InvoiceAnalysisApiSelection"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "extraction_source": {
                "const": "active_api_generation"
              }
            }
          },
          "else": {
            "properties": {
              "extraction_source": {
                "const": "active_agentic_generation"
              }
            }
          }
        }
      ]
    },
    "InvoiceAnalysisAnalyzedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "analyzed"
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_required": {
          "const": true
        },
        "extraction_source": {
          "enum": [
            "active_agentic_generation",
            "active_api_generation"
          ]
        },
        "business_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "$ref": "#/$defs/InvoiceAnalysisSource"
        },
        "selection": {
          "$ref": "#/$defs/InvoiceAnalysisSelection"
        },
        "extraction": {
          "$ref": "#/$defs/InvoiceAnalysisExtraction"
        }
      },
      "required": [
        "status",
        "analysis_id",
        "review_required",
        "extraction_source",
        "business_id",
        "provider_id",
        "attachment_id",
        "source",
        "selection",
        "extraction"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "$ref": "#/$defs/InvoiceAnalysisApiSelection"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "extraction_source": {
                "const": "active_api_generation"
              }
            }
          },
          "else": {
            "properties": {
              "extraction_source": {
                "const": "active_agentic_generation"
              }
            }
          }
        }
      ]
    },
    "InvoiceAnalysisResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/InvoiceAnalysisPreparedResult"
        },
        {
          "$ref": "#/$defs/InvoiceAnalysisAnalyzedResult"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "prepared",
            "analyzed"
          ]
        },
        "analysis_id": {
          "type": "string",
          "format": "uuid"
        },
        "review_required": {
          "const": true
        },
        "extraction_source": {
          "enum": [
            "active_agentic_generation",
            "active_api_generation"
          ]
        },
        "business_id": {
          "type": "string",
          "format": "uuid"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "$ref": "#/$defs/InvoiceAnalysisSource"
        },
        "selection": {
          "$ref": "#/$defs/InvoiceAnalysisSelection"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "extraction": {
          "$ref": "#/$defs/InvoiceAnalysisExtraction"
        }
      },
      "required": [
        "status"
      ]
    },
    "InvoiceAnalysisApiSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "maxLength": 19
        },
        "mode": {
          "const": "api_key"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "effort_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "connection_id",
        "mode",
        "model_id",
        "effort_id"
      ]
    }
  }
}
