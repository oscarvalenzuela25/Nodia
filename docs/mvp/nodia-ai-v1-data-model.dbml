// NodiaAI ERD revision3: M1 persistence; later groups remain design only.
// Full checks, partial indexes, stages and deferrability: JSON manifest and42/55.

Table users {
  id bigint [not null, pk]
}

Table auth_sessions {
  id bigint [not null, pk]
  public_id uuid [not null]
  indexes {
    (public_id) [unique]
  }
}

Table ai_providers {
  id bigint [not null, pk]
}

Table nodia_ai_conversations {
  id uuid [not null, pk]
  owner_id bigint [not null]
  client_request_id uuid [not null]
  title text [null]
  is_pinned boolean [not null]
  is_archived boolean [not null]
  revision integer [not null]
  retention_epoch bigint [not null]
  selected_connection_id bigint [null]
  selected_mode text [null]
  selected_model_id text [null]
  active_job_id uuid [null]
  next_message_seq bigint [not null]
  next_event_seq bigint [not null]
  last_owner_message_at timestamptz [null]
  expires_at timestamptz [not null]
  lifecycle text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  creation_request_hash char(64) [not null]
  selected_effort_id text [null]
  routing_revision integer [not null]
  routing_enabled boolean [not null]
  routing_target_selection jsonb [null]
  indexes {
    (owner_id, client_request_id) [unique]
  }
}

Table nodia_ai_messages {
  id uuid [not null, pk]
  conversation_id uuid [not null]
  seq bigint [not null]
  role text [not null]
  author_id bigint [null]
  client_message_id uuid [null]
  status text [not null]
  source_scope_manifest jsonb [not null]
  created_at timestamptz [not null]
  sealed_at timestamptz [null]
  input_hash char(64) [null]
  indexes {
    (id, conversation_id) [unique]
    (conversation_id, seq) [unique]
    (conversation_id, author_id, client_message_id) [unique]
  }
}

Table nodia_ai_attachments {
  id uuid [not null, pk]
  conversation_id uuid [not null]
  kind text [not null]
  state text [not null]
  storage_key text [not null]
  content_hash char(64) [null]
  media_type text [null]
  byte_size bigint [null]
  page_count integer [null]
  duration_seconds numeric [null]
  transcript text [null]
  derived_text text [null]
  storage_generation uuid [not null]
  created_at timestamptz [not null]
  indexes {
    (id, conversation_id) [unique]
    (storage_key) [unique]
  }
}

Table nodia_ai_message_parts {
  message_id uuid [not null]
  conversation_id uuid [not null]
  part_index integer [not null]
  kind text [not null]
  text text [null]
  attachment_id uuid [null]
  indexes {
    (message_id, part_index) [pk]
  }
}

Table nodia_ai_context_snapshots {
  id uuid [not null, pk]
  conversation_id uuid [not null]
  revision integer [not null]
  through_message_seq bigint [not null]
  source_hash char(64) [not null]
  summary jsonb [not null]
  scope_manifest jsonb [not null]
  builder_contract_version text [not null]
  created_at timestamptz [not null]
  indexes {
    (id, conversation_id) [unique]
    (conversation_id, revision) [unique]
  }
}

Table nodia_ai_adapter_states {
  id uuid [not null, pk]
  conversation_id uuid [not null]
  connection_id bigint [null]
  mode text [not null]
  model_id text [not null]
