    (token_hash) [unique]
    (proposal_id, proposal_revision, actor_id, session_public_id) [unique]
  }
}

Table nodia_ai_executions {
  id uuid [not null, pk]
  conversation_id uuid [null]
  proposal_id uuid [null]
  origin_conversation_id uuid [not null]
  origin_proposal_id uuid [not null]
