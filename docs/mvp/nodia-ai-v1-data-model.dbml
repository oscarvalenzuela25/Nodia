  indexes {
    (proposal_id, proposal_revision, position) [unique]
    (id, proposal_id, proposal_revision) [unique]
  }
}

Table nodia_ai_confirmation_challenges {
  id uuid [not null, pk]
  proposal_id uuid [not null]
