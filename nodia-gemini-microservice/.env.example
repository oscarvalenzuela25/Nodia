# Microservice Port
PORT=8000
# Local host execution: accept connections only from this machine.
# Docker Compose explicitly overrides this to 0.0.0.0 inside its private container.
HOST=127.0.0.1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value in nodia-server; never commit it.
GEMINI_SERVICE_TOKEN=

# Gemini Web Authentication Cookies (from gemini.google.com)
# __Secure-1PSID (or 1PSID)
GEMINI_SECURE_1PSID=

# __Secure-1PSIDTS (or 1PSIDTS)
GEMINI_SECURE_1PSIDTS=

# Optional display metadata only. Analysis requires an explicit discovered model from Server.
GEMINI_MODEL=

# Bound upload admission and analysis in a single worker.
MAX_INVOICE_FILE_BYTES=10485760
ANALYSIS_SLOTS=2
UPLOAD_TIMEOUT_SECONDS=30
ANALYSIS_TIMEOUT_SECONDS=130
