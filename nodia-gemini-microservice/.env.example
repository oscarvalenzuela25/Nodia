# Microservice Port
PORT=8000
# Local host execution: accept connections only from this machine.
# Docker Compose explicitly overrides this to 0.0.0.0 inside its private container.
HOST=127.0.0.1
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value in nodia-server; never commit it.
GEMINI_SERVICE_TOKEN=

# Bound upload admission and analysis in a single worker.
MAX_INVOICE_FILE_BYTES=10485760
ANALYSIS_SLOTS=2
UPLOAD_TIMEOUT_SECONDS=30
ANALYSIS_TIMEOUT_SECONDS=300

# Official CLI is opt-in; all three values are mandatory. Paths must be absolute.
# Install with scripts/install_agentic_cli.py; SHA512 comes from verified.json.
# Use a dedicated profile outside this repository, owned by the service account.
ANTIGRAVITY_CLI_PATH=
ANTIGRAVITY_CLI_SHA512=
ANTIGRAVITY_CLI_HOME=
# Historical contract; 1.4.2 is an explicit chat/MCP lab candidate, not OCR/attachments.
ANTIGRAVITY_CLI_VERSION=1.3.1
# Generation <=240s; analysis session/model preflight each <=25s; status <=12s.
ANTIGRAVITY_CLI_TIMEOUT_SECONDS=240

# Teacher only: an explicitly installed, root-owned bounded SDK runtime.
# Both values are required. Missing/invalid configuration disables Teacher;
# chat/OCR retain their separate CLI adapter. This never reuses CLI credentials.
# Installation and manual personal OAuth are described in ADR-094.
NODIA_TEACHER_SDK_ROOT=
NODIA_TEACHER_SDK_MANIFEST_SHA256=
