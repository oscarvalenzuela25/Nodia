# Microservice Port
PORT=8000
HOST=0.0.0.0

# Gemini Web Authentication Cookies (from gemini.google.com)
# __Secure-1PSID (or 1PSID)
GEMINI_SECURE_1PSID=your_secure_1psid_cookie_here

# __Secure-1PSIDTS (or 1PSIDTS)
GEMINI_SECURE_1PSIDTS=your_secure_1psidts_cookie_here

# Gemini Web Model Selection:
# - gemini-flash : Gemini 3.8 Flash (Recomendado / Rápido y preciso para facturas, ~48k cuota diaria)
# - gemini-pro   : Gemini 3.1 Pro (Razonamiento profundo / Tablas complejas, ~2.4k cuota diaria)
# - gemini-flash-lite : Gemini 3.5 Flash-Lite (Respuestas ultra livianas)
GEMINI_MODEL=gemini-flash
