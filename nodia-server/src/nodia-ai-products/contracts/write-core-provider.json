      "BigintId": {
        "type": "string",
        "maxLength": 19,
        "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
      },
      "IdList": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/BigintId"
        }
      },
      "ActionReference": {
        "anyOf": [
          {
            "$ref": "#/$defs/BigintId"
          },
          {
            "type": "string",
            "maxLength": 255,
            "pattern": "[^0-9]"
          }
        ]
      },
      "ActionList": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/ActionReference"
        }
      },
      "Translation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "es": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": ["key", "es", "en"]
      },
      "Translations": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/Translation"
        }
      },
      "Mode": {
        "enum": ["api_key", "token_plan_web", "token_plan_agentic"]
      },
      "ModelPreference": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
