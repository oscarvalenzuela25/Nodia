{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodia.local/nodia-ai/ai-settings-read/1",
  "$defs": {
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["page", "limit", "total_items", "total_pages"]
    },
    "ProviderRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "catalog_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "is_active": {
          "type": "boolean"
        },
        "is_default": {
          "type": "boolean"
        },
        "use_api_key": {
          "type": "boolean"
        },
        "use_agentic": {
          "type": "boolean"
        },
        "default_mode": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["api_key", "agentic"]
            },
            {
              "type": "null"
            }
          ]
        },
        "auto_rotate_api_keys": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "catalog_id",
        "name",
        "key",
        "is_active",
        "is_default",
        "use_api_key",
        "use_agentic",
        "default_mode",
        "auto_rotate_api_keys"
      ]
    },
    "KeyRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "display_hint": {
          "type": "string",
          "maxLength": 16
        },
        "sort_order": {
          "type": "integer"
        },
        "is_selected": {
          "type": "boolean"
        },
        "is_active": {
          "type": "boolean"
        },
        "health_state": {
          "type": "string",
          "maxLength": 64
        },
        "cooldown_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider_id",
        "label",
        "display_hint",
        "sort_order",
        "is_selected",
        "is_active",
        "health_state",
        "cooldown_until",
        "last_success_at",
        "last_error_at",
        "last_error_code"
      ]
    },
    "EventRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "api_key_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor_user_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_type": {
          "type": "string",
          "maxLength": 64
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "is_active": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "provider_id",
        "api_key_id",
        "actor_user_id",
        "event_type",
        "reason_code",
        "created_at",
        "is_active"
      ]
    },
    "CatalogRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "key": {
          "type": "string",
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "is_active": {
          "type": "boolean"
        },
        "can_use_api_key": {
          "type": "boolean"
        },
        "can_use_agentic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "key",
        "name",
        "is_active",
        "can_use_api_key",
        "can_use_agentic"
      ]
    },
    "SupportedRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "default_mode": {
          "type": "string",
          "maxLength": 4096
        },
        "supported_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 8
        }
      },
      "required": [
        "key",
        "name",
        "description",
        "default_mode",
        "supported_modes"
      ]
    },
    "ProvidersInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "activity": {
          "type": "string",
          "enum": ["active", "inactive", "all"]
        },
        "q": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "name_cont": {
              "type": "string",
              "maxLength": 256
            },
            "key_eq": {
              "type": "string",
              "maxLength": 64
            },
            "catalog_id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "is_default_eq": {
              "type": "boolean"
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "ProvidersResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderRow"
          },
          "maxItems": 100
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": ["data", "meta"]
    },
    "KeysInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "activity": {
          "type": "string",
          "enum": ["active", "inactive", "all"]
        },
        "q": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "label_cont": {
              "type": "string",
              "maxLength": 256
            },
            "is_selected_eq": {
              "type": "boolean"
            },
            "health_state_eq": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "KeysResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyRow"
          },
          "maxItems": 100
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": ["data", "meta"]
    },
    "EventsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "activity": {
          "type": "string",
          "enum": ["active", "inactive", "all"]
        },
        "q": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider_id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "api_key_id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "actor_user_id_eq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "event_type_eq": {
              "type": "string",
              "maxLength": 64
            },
            "reason_code_eq": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "EventsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventRow"
          },
          "maxItems": 100
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      },
      "required": ["data", "meta"]
    },
    "CatalogInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "CatalogResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogRow"
          },
          "maxItems": 100
        }
      },
      "required": ["items"]
    },
    "SupportedInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "SupportedResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupportedRow"
          },
          "maxItems": 100
        }
      },
      "required": ["items"]
    }
  }
}
