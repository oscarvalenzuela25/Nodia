{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://nodia.local/schemas/write-reservations/1",
    "$defs": {
      "RentalId": {
        "type": "string",
        "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
        "maxLength": 19
      },
      "PositiveMoney": {
        "$ref": "#/$defs/RentalId"
      },
      "Money": {
        "type": "string",
        "pattern": "^(?:0|(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807))$",
        "maxLength": 19
      },
      "Percent": {
        "type": "string",
        "pattern": "^(?:(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,2})?|100(?:\\.0{1,2})?)$",
        "maxLength": 6
      },
      "CivilDate": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:19[0-9]{2}|[2-9][0-9]{3})-[0-9]{2}-[0-9]{2}$",
        "maxLength": 10
      },
      "LocalTime": {
        "type": "string",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
        "maxLength": 5
      },
      "Instant": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:19[0-9]{2}|[2-9][0-9]{3})-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
        "maxLength": 29
      },
      "Timezone": {
        "type": "string",
        "pattern": "^(?:[A-Za-z_]+(?:/[A-Za-z_+\\-0-9]+)+|UTC|GMT)$",
        "maxLength": 64,
        "description": "Zona validada por Intl en el backend; su sintaxis no acredita disponibilidad."
      },
      "PlatformPolicy": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": ["reference", "description"]
      },
      "CancellationRule": {
        "type": "object",
        "properties": {
          "min_days_before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36500
          },
          "refund_percent": {
            "$ref": "#/$defs/Percent"
          }
        },
        "additionalProperties": false,
        "required": ["min_days_before", "refund_percent"]
      },
      "CancellationRules": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/CancellationRule"
        }
      },
      "PropertyCreate": {
        "type": "object",
        "properties": {
          "owner_id": {
            "$ref": "#/$defs/RentalId"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S"
          },
          "timezone": {
            "$ref": "#/$defs/Timezone"
          },
          "max_guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "check_in_time": {
            "anyOf": [
              {
                "$ref": "#/$defs/LocalTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "check_out_time": {
            "anyOf": [
              {
                "$ref": "#/$defs/LocalTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "default_nightly_rate": {
            "anyOf": [
              {
                "$ref": "#/$defs/PositiveMoney"
              },
              {
                "type": "null"
              }
            ]
          },
          "default_deposit_percent": {
            "anyOf": [
              {
                "$ref": "#/$defs/Percent"
              },
              {
                "type": "null"
              }
            ]
          },
          "minimum_turnover_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10080
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ]
          },
          "is_active": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PropertyUpdate": {
        "type": "object",
        "properties": {
          "property_id": {
