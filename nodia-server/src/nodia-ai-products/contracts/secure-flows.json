{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://nodia.local/schemas/secure-flows/1",
    "$defs": {
      "BigintId": {
        "type": "string",
        "maxLength": 19,
        "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
      },
      "ApiKeyCreatePartial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": {
            "$ref": "#/$defs/BigintId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "is_selected": {
            "type": "boolean"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "ApiKeyUpdatePartial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": {
            "$ref": "#/$defs/BigintId"
          },
          "key_id": {
            "$ref": "#/$defs/BigintId"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "is_selected": {
            "type": "boolean"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "ConnectionLoginPartial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider_id": {
            "$ref": "#/$defs/BigintId"
          },
          "mode": {
            "enum": ["agentic"]
          }
        }
      },
      "NodiaLogoutPartial": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  },
  "tools": [
    {
      "tool_name": "nodia_secure_flows_prepare_api_key_create",
      "input_definition": "ApiKeyCreatePartial",
      "resource_key": "secure_flows",
      "description": "Prepara la creación de una API key mediante sus metadatos públicos. El secreto se introduce sólo en el canal humano seguro tras confirmar la propuesta.",
      "kind": "prepare_secure_flow"
    },
    {
      "tool_name": "nodia_secure_flows_prepare_api_key_update",
      "input_definition": "ApiKeyUpdatePartial",
      "resource_key": "secure_flows",
      "description": "Prepara la actualización de una API key exacta mediante metadatos públicos. Su secreto opcional se introduce sólo en el canal humano seguro tras confirmar la propuesta.",
      "kind": "prepare_secure_flow"
    },
    {
      "tool_name": "nodia_secure_flows_prepare_connection_login",
      "input_definition": "ConnectionLoginPartial",
      "resource_key": "secure_flows",
      "description": "Prepara el login de la conexión y modo exactos. El visor, códigos y autorización permanecen exclusivamente en el canal humano seguro tras confirmar la propuesta.",
      "kind": "prepare_secure_flow"
    },
    {
      "tool_name": "nodia_secure_flows_prepare_nodia_logout",
      "input_definition": "NodiaLogoutPartial",
      "resource_key": "nodia_sessions",
      "description": "Prepara el cierre de la sesión Nodia actual del actor autenticado, sin aceptar otra identidad. Su confirmación permanece exclusivamente en el canal humano.",
      "kind": "prepare_secure_flow"
    }
  ]
}
