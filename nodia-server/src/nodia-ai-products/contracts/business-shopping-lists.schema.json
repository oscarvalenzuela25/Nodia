{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodia.local/schemas/business-shopping-lists-read/1",
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Page": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "Count": { "type": "integer", "minimum": 0 },
    "ListName": { "type": "string", "minLength": 1, "maxLength": 150 },
    "ItemCount": { "type": "integer", "minimum": 0, "maximum": 500 },
    "ShoppingListsListInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_id"],
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "search": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[^\\u0000]*$"
        },
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "ShoppingListsGetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_id", "id"],
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "id": { "$ref": "#/$defs/Uuid" },
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "limit", "total_items", "total_pages"],
      "properties": {
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
        "total_items": { "$ref": "#/$defs/Count" },
        "total_pages": { "$ref": "#/$defs/Count" }
      }
    },
    "ListSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_id", "id", "name", "is_active", "item_count"],
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "$ref": "#/$defs/ListName" },
        "is_active": { "type": "boolean" },
        "item_count": { "$ref": "#/$defs/ItemCount" }
      }
    },
    "ListItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product_id",
        "name",
        "quantity",
        "position",
        "available",
        "checked"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "product_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "name": { "type": "string", "maxLength": 255 },
        "quantity": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,8}(?:\\.[0-9]{0,2}[1-9])?|0\\.[0-9]{0,2}[1-9])$"
        },
        "position": { "$ref": "#/$defs/Count" },
        "available": { "type": "boolean" },
        "checked": { "type": "boolean" }
      }
    },
    "ListDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_id",
        "id",
        "name",
        "is_active",
        "item_count",
        "items"
      ],
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "$ref": "#/$defs/ListName" },
        "is_active": { "type": "boolean" },
        "item_count": { "$ref": "#/$defs/ItemCount" },
        "items": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/ListItem" }
        }
      }
    },
    "ShoppingListsListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/ListSummary" }
        },
        "meta": { "$ref": "#/$defs/Pagination" }
      }
    },
    "ShoppingListsGetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "meta"],
      "properties": {
        "data": { "$ref": "#/$defs/ListDetail" },
        "meta": { "$ref": "#/$defs/Pagination" }
      }
    }
  }
}
