      "WriteTranslation": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/$defs/WriteText"
          },
          "es": {
            "type": "string",
            "minLength": 0
          },
          "en": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "key",
          "es",
          "en"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "key": {
                  "enum": [
                    "description",
                    "comment"
                  ]
                }
              },
              "required": [
                "key"
              ]
            },
            "then": {},
            "else": {
              "properties": {
                "es": {
                  "type": "string",
                  "minLength": 1
                },
                "en": {
                  "type": "string",
                  "minLength": 1
                }
