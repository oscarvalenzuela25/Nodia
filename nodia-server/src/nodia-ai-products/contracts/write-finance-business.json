        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "object"
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/WriteJsonObjectMember"
                },
                "minItems": 0,
                "maxItems": 128
              }
            },
            "required": [
              "kind",
              "fields"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "array"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/WriteJsonValue"
                },
                "minItems": 0,
                "maxItems": 128
              }
            },
            "required": [
              "kind",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "string"
              },
              "value": {
                "type": "string",
                "minLength": 0
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "number"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
