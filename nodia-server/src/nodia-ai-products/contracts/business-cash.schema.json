{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodia.local/schemas/business-cash/1",
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
    "CivilDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Page": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "Limit": { "type": "integer", "minimum": 1, "maximum": 10 },
    "Count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Activity": { "enum": ["active", "inactive", "all"] },
    "Search": { "type": "string", "maxLength": 255 },
    "Pagination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "$ref": "#/$defs/Limit" },
        "total_items": { "$ref": "#/$defs/Count" },
        "total_pages": { "$ref": "#/$defs/Count" }
      },
      "required": ["page", "limit", "total_items", "total_pages"]
    },
    "Category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "business_id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "business_id", "name", "description", "is_active"]
    },
    "CategoryRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "name", "is_active"]
    },
    "InvoiceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "code": { "type": ["string", "null"], "maxLength": 255 }
      },
      "required": ["id", "code"]
    },
    "Movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "business_id": { "$ref": "#/$defs/Uuid" },
        "category": { "$ref": "#/$defs/CategoryRef" },
        "type": { "enum": ["income", "expense"] },
        "amount": { "type": "string", "pattern": "^[1-9][0-9]{0,12}$" },
        "occurred_on": { "$ref": "#/$defs/CivilDate" },
        "is_active": { "type": "boolean" },
        "source": { "enum": ["manual", "invoice"] },
        "description": { "type": ["string", "null"], "maxLength": 500 },
        "invoice": {
          "anyOf": [{ "$ref": "#/$defs/InvoiceRef" }, { "type": "null" }]
        }
      },
      "required": [
        "id",
        "business_id",
        "category",
        "type",
        "amount",
        "occurred_on",
        "is_active",
        "source",
        "description",
        "invoice"
      ]
    },
    "Totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": { "$ref": "#/$defs/Count" },
        "total_amount": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,31})$"
        }
      },
      "required": ["count", "total_amount"]
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": { "const": "CLP" },
        "income": { "$ref": "#/$defs/Totals" },
        "expense": { "$ref": "#/$defs/Totals" }
      },
      "required": ["currency", "income", "expense"]
    },
    "CashCategoriesListInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "$ref": "#/$defs/Limit" },
        "activity": { "$ref": "#/$defs/Activity" },
        "search": { "$ref": "#/$defs/Search" }
      },
      "required": ["business_id"]
    },
    "CashCategoriesListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "data": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/Category" }
        },
        "meta": { "$ref": "#/$defs/Pagination" }
      },
      "required": ["business_id", "data", "meta"]
    },
    "CashMovementsListInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "page": { "$ref": "#/$defs/Page" },
        "limit": { "$ref": "#/$defs/Limit" },
        "activity": { "$ref": "#/$defs/Activity" },
        "search": { "$ref": "#/$defs/Search" },
        "category_id": { "$ref": "#/$defs/Id" },
        "from": { "$ref": "#/$defs/CivilDate" },
        "to": { "$ref": "#/$defs/CivilDate" }
      },
      "required": ["business_id"]
    },
    "CashMovementsListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "data": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/Movement" }
        },
        "meta": { "$ref": "#/$defs/Pagination" },
        "summary": { "$ref": "#/$defs/Summary" }
      },
      "required": ["business_id", "data", "meta", "summary"]
    },
    "CashMovementsGetInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "id": { "$ref": "#/$defs/Uuid" }
      },
      "required": ["business_id", "id"]
    },
    "CashMovementsGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "data": { "$ref": "#/$defs/Movement" }
      },
      "required": ["business_id", "data"]
    },
    "CashMonthlySummaryInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "business_id": { "$ref": "#/$defs/Uuid" } },
      "required": ["business_id"]
    },
    "CashMonthlySummaryResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business_id": { "$ref": "#/$defs/Uuid" },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": { "$ref": "#/$defs/CivilDate" },
            "to": { "$ref": "#/$defs/CivilDate" },
            "time_zone": { "const": "America/Santiago" }
          },
          "required": ["from", "to", "time_zone"]
        },
        "summary": { "$ref": "#/$defs/Summary" }
      },
      "required": ["business_id", "period", "summary"]
    }
  }
}
