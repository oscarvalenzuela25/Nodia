# Application
PORT=3000
GOOGLE_CLIENT_ID=
AUTH_JWT_SECRET=dev_nodia_super_secret_jwt_key_at_least_32_bytes_long_12345
AUTH_ALLOWED_ORIGINS=http://localhost:5174
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
SECRET_SEED=dev_secret_seed_change_in_prod

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nodia_db
POSTGRES_USER=nodia_user
POSTGRES_PASSWORD=nodia_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_PASSWORD

# R2 credentials for file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI ZONE
# Gemini Web microservice (browser session configured in nodia-gemini-microservice/.env)
GEMINI_MICROSERVICE_URL=http://127.0.0.1:8000
# Generate once with Python secrets.token_hex(32); configure the same value in the microservice.
GEMINI_SERVICE_TOKEN=

# 32 random bytes as 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SECRET_MASTER_KEY=
# Set only while migrating pre-v2 AI keys, then remove it.
AI_LEGACY_MASTER_KEY=

# Rate limit: redis is shared across replicas; memory is development/test only.
NODE_ENV=development
RATE_LIMIT_STORAGE=memory # redis is in production, memory is for development/test only.
# Optional dedicated connection (supports TLS via rediss://).
# Otherwise uses REDIS_HOST, REDIS_PORT and REDIS_PASSWORD above.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_TIMEOUT_MS=1000
# Defaults to nodia:<NODE_ENV>:rl:v1. Use distinct prefixes per deployment.
# RATE_LIMIT_KEY_PREFIX=nodia:development:rl:v1
RATE_LIMIT_BURST_LIMIT=30
RATE_LIMIT_BURST_TTL_MS=10000
RATE_LIMIT_GENERAL_LIMIT=300
RATE_LIMIT_GENERAL_TTL_MS=60000
RATE_LIMIT_WRITES_LIMIT=30
RATE_LIMIT_WRITES_TTL_MS=60000
# Login attempts per IP, including invalid credentials/origins/payloads.
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_MS=60000
# Per verified user, shared across sessions, tokens and IPs.
RATE_LIMIT_USER_LIMIT=300
RATE_LIMIT_USER_TTL_MS=60000
RATE_LIMIT_USER_WRITES_LIMIT=30
RATE_LIMIT_USER_WRITES_TTL_MS=60000
# Optional RATE_LIMIT_<BURST|GENERAL|WRITES|LOGIN|USER|USER_WRITES>_BLOCK_MS
# defaults to that policy's TTL. IP quotas still apply to authenticated users.
# Trusted reverse proxy IPs/CIDRs only, comma-separated. Empty = direct access.
# Confirm the actual ingress network before setting this in production.
TRUST_PROXY=

# Codex Agentic: local runtime, separate profile per OpenAI connection.
# Strict OS keyring required. Never reuse the global CODEX_HOME or auth.json.
NODIA_CODEX_ENABLED=false
# Absolute canonical path, outside the repository, owned by the server user (0700).
# Default: ~/.local/share/nodia/codex
# NODIA_CODEX_PROFILE_ROOT=
# Total budget, 1000..300000 ms; Client transport is 360000 ms.
NODIA_CODEX_INVOICE_TIMEOUT_MS=300000
