# Application
PORT=3000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=template_db
POSTGRES_USER=template_user
POSTGRES_PASSWORD=template_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limit: redis is shared across replicas; memory is development/test only.
NODE_ENV=development
RATE_LIMIT_STORAGE=redis
# Optional dedicated connection (supports TLS via rediss://).
# Otherwise uses REDIS_HOST, REDIS_PORT and REDIS_PASSWORD above.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_TIMEOUT_MS=1000
# Defaults to nodia:<NODE_ENV>:rl:v1. Use distinct prefixes per deployment.
# RATE_LIMIT_KEY_PREFIX=nodia:development:rl:v1
RATE_LIMIT_BURST_LIMIT=30
RATE_LIMIT_BURST_TTL_MS=10000
RATE_LIMIT_GENERAL_LIMIT=300
RATE_LIMIT_GENERAL_TTL_MS=60000
RATE_LIMIT_WRITES_LIMIT=30
RATE_LIMIT_WRITES_TTL_MS=60000
# Login attempts per IP, including invalid credentials/origins/payloads.
RATE_LIMIT_LOGIN_LIMIT=10
RATE_LIMIT_LOGIN_TTL_MS=60000
# Per verified user, shared across sessions, tokens and IPs.
RATE_LIMIT_USER_LIMIT=300
RATE_LIMIT_USER_TTL_MS=60000
RATE_LIMIT_USER_WRITES_LIMIT=30
RATE_LIMIT_USER_WRITES_TTL_MS=60000
# Optional RATE_LIMIT_<BURST|GENERAL|WRITES|LOGIN|USER|USER_WRITES>_BLOCK_MS
# defaults to that policy's TTL. IP quotas still apply to authenticated users.
# Trusted reverse proxy IPs/CIDRs only, comma-separated. Empty = direct access.
# Confirm the actual ingress network before setting this in production.
TRUST_PROXY=
GOOGLE_CLIENT_ID=648664263695-atejjacv8uedispitjeg339ivdj9mm4b.apps.googleusercontent.com
AUTH_JWT_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:5174
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
