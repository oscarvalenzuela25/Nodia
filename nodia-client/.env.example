# Desarrollo / QA: el navegador usa el mismo origen que el frontend.
# En producción con API separada, usar su URL HTTPS completa.
# Ejemplo: https://api.nodia.app/api/v1
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=
NODE_VERSION=24.20.0
# Solo dev, prod se quita; no se expone al bundle. Destino local del proxy de desarrollo.
NODIA_API_PROXY_TARGET=http://localhost:3000
