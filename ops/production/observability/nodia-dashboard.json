{
  "id": null,
  "uid": "nodia-observabilidad",
  "title": "Nodia · Observabilidad",
  "description": "Disponibilidad desde sondas externas, métricas de Alloy en el VPS y eventos HTTP saneados de Loki.",
  "tags": [
    "nodia",
    "observabilidad",
    "produccion"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Última sonda externa",
      "description": "Último resultado por destino y ubicación en 12 minutos. Las sondas se ejecutan cada cinco minutos.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "last_over_time(probe_success{job=~\"nodia-(web|api)\"}[12m])",
          "legendFormat": "{{job}} · {{probe}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Fallo"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "OK"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "title": "Alloy y servicios del VPS",
      "description": "La serie Alloy refleja el último scrape. Los servicios muestran el estado activo de systemd.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "up{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\"}",
          "legendFormat": "Scrape de Alloy",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "editorMode": "code",
          "expr": "node_systemd_unit_state{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\",state=\"active\"}",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Fallo"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "OK"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "title": "HTTP · últimos 15 min",
      "description": "El panel muestra cero 5xx cuando hay peticiones observadas sin errores de servidor. Una ventana sin registros muestra Sin datos.",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"nodia-http\",instance=\"nodia-vps\",environment=\"production\"} |= \"\\\"event\\\":\\\"http_request\\\"\"[15m]))",
          "legendFormat": "Peticiones",
          "queryType": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"nodia-http\",instance=\"nodia-vps\",environment=\"production\"} |= \"\\\"event\\\":\\\"http_request\\\"\" | json | __error__=\"\" | status >= 500 [15m])) or (0 * sum(count_over_time({job=\"nodia-http\",instance=\"nodia-vps\",environment=\"production\"} |= \"\\\"event\\\":\\\"http_request\\\"\"[15m])))",
          "legendFormat": "HTTP 5xx",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin datos",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [{ "id": "displayName", "value": "Peticiones" }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "displayName", "value": "HTTP 5xx" }]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "title": "Disponibilidad externa por ubicación",
      "description": "Porcentaje de pruebas satisfactorias en una ventana móvil de 15 minutos. Los huecos indican ausencia de muestras.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * avg_over_time(probe_success{job=~\"nodia-(web|api)\"}[15m])",
          "legendFormat": "{{job}} · {{probe}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "CPU, memoria y disco del VPS",
      "description": "CPU no ociosa, memoria usada a partir de MemAvailable y espacio ocupado del volumen raíz.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\",mode=\"idle\"}[5m])))",
          "legendFormat": "CPU",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "B",
          "editorMode": "code",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\"} / node_memory_MemTotal_bytes{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\"})",
          "legendFormat": "Memoria",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "refId": "C",
          "editorMode": "code",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"nodia-host\",instance=\"nodia-vps\",environment=\"production\",mountpoint=\"/\"})",
          "legendFormat": "Disco raíz",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "max": 100,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Peticiones por familia · 5 min",
      "description": "Recuento móvil de eventos HTTP registrados por Nginx en cada familia de ruta permitida.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (route) (count_over_time({job=\"nodia-http\",instance=\"nodia-vps\",environment=\"production\"} |= \"\\\"event\\\":\\\"http_request\\\"\" | json | __error__=\"\" [5m]))",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Duración HTTP media por familia",
      "description": "Tiempo total de petición medido por Nginx. Cada punto resume las peticiones de los últimos 15 minutos.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "1000 * avg_over_time({job=\"nodia-http\",instance=\"nodia-vps\",environment=\"production\"} |= \"\\\"event\\\":\\\"http_request\\\"\" | json | __error__=\"\" | unwrap duration_s | __error__=\"\" [15m]) by (route)",
          "legendFormat": "{{route}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "Sin datos",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "min": 0,
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
